# Portal RH - exemplo de ambiente de PRODUÇÃO
APP_ENV=production

# Gere uma chave longa e aleatória. NUNCA publique a chave real no Git.
SECRET_KEY=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_FORTE

# PostgreSQL recomendado:
# postgresql://usuario:senha@host:5432/banco
DATABASE_URL=postgresql://usuario:senha@host:5432/portal_rh

# Em hospedagem com disco persistente, aponte para o volume:
UPLOAD_FOLDER=/var/data/portal-rh/uploads

MAX_UPLOAD_MB=10
SESSION_MINUTES=240
PORT=10000

# E-mail interno para tratamento de incidentes de segurança
SECURITY_CONTACT=rh@associacao.local


# Microsoft 365 / Outlook - envio automático de atestados conferidos
# Cadastre o app no Microsoft Entra ID e conceda Microsoft Graph > Application > Mail.Send.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
M365_MAIL_SENDER=admalecrimdourado@assalecrimdourado.onmicrosoft.com
M365_CERTIFICATE_RECIPIENTS=jaqueline@saviancontabilidade.com.br,flavia@saviancontabilidade.com.br,augusto.ribeiro@associacaoalecrimdourado.com.br,rosimeire.alves@associacaoalecrimdourado.com.br
