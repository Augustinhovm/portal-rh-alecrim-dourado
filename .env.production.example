# Portal RH - exemplo de ambiente de PRODUÇÃO
APP_ENV=production

# Gere uma chave longa e aleatória. NUNCA publique a chave real no Git.
SECRET_KEY=COLOQUE_AQUI_UMA_CHAVE_ALEATORIA_FORTE

# PostgreSQL recomendado:
# postgresql://usuario:senha@host:5432/banco
DATABASE_URL=postgresql://usuario:senha@host:5432/portal_rh

# Em hospedagem com disco persistente, aponte para o volume:
UPLOAD_FOLDER=/var/data/portal-rh/uploads

MAX_UPLOAD_MB=10
SESSION_MINUTES=480
PORT=10000
